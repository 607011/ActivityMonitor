// Application resources. The DPI-awareness manifest is supplied to the
// linker directly (see CMakeLists.txt) rather than embedded here, to avoid
// clashing with the manifest MSVC's linker generates by default.
#include "resource.h"
#include "version.h" // generated by CMake from src/version.h.in
#include <winver.h>

IDI_APPICON ICON "../app.ico"

// Stringize helpers, to turn the numeric APP_VERSION_* macros into the
// dotted "1.2.3.0" text shown on the Details tab of the file's Properties.
#define APP_STRINGIZE2(x) #x
#define APP_STRINGIZE(x) APP_STRINGIZE2(x)
#define APP_VERSION_DOTTED \
    APP_STRINGIZE(APP_VERSION_MAJOR) "." APP_STRINGIZE(APP_VERSION_MINOR) "." \
    APP_STRINGIZE(APP_VERSION_PATCH) "." APP_STRINGIZE(APP_VERSION_BUILD)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,APP_VERSION_BUILD
 PRODUCTVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,APP_VERSION_BUILD
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0" // U.S. English, Unicode
        BEGIN
            VALUE "FileDescription", "CPU Activity Monitor"
            VALUE "FileVersion", APP_VERSION_DOTTED
            VALUE "InternalName", "ActivityMonitor"
            VALUE "OriginalFilename", "ActivityMonitor.exe"
            VALUE "ProductName", "CPU Activity Monitor"
            VALUE "ProductVersion", APP_VERSION_DOTTED
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
